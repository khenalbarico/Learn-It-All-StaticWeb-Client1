@inject IAppService AppService
@inject IAppAuthentication Auth

<ErrorBanner Message="@_error" />

<div class="field">
    <label for="profile-first">First name</label>
    <input id="profile-first" class="input" @bind="_firstName" @bind:event="oninput" autocomplete="given-name" />
</div>

<div class="field">
    <label for="profile-last">Last name</label>
    <input id="profile-last" class="input" @bind="_lastName" @bind:event="oninput" autocomplete="family-name" />
</div>

<div class="field">
    <label for="profile-phone">Phone number</label>
    <input id="profile-phone" class="input" type="tel" @bind="_phone" @bind:event="oninput" autocomplete="tel" placeholder="09XXXXXXXXX" />
</div>

<button class="btn btn-primary btn-block" @onclick="SubmitAsync" disabled="@(_busy || !IsValid)">
    @if (_busy) { <span class="spinner"></span> } else { <text>Continue</text> }
</button>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private string  _firstName = "";
    private string  _lastName = "";
    private string  _phone = "";
    private string? _error;
    private bool    _busy;

    private bool IsValid
        => !string.IsNullOrWhiteSpace(_firstName)
        && !string.IsNullOrWhiteSpace(_lastName)
        && !string.IsNullOrWhiteSpace(_phone);

    // Prefill from whatever the identity provider gave us so most users just press Continue.
    protected override async Task OnInitializedAsync()
    {
        var hint = await Auth.GetProfileHintAsync();
        _firstName = hint.FirstName ?? "";
        _lastName  = hint.LastName ?? "";
        _phone     = hint.PhoneNumber ?? "";
    }

    private async Task SubmitAsync()
    {
        _busy  = true;
        _error = null;

        try
        {
            await AppService.CreateUser(_firstName.Trim(), _lastName.Trim(), _phone.Trim());
            await OnCompleted.InvokeAsync();
        }
        catch (ApiUnavailableException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Could not save your details. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
