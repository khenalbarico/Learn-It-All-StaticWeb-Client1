@implements IDisposable
@inject AuthSessionState AuthState
@inject IAppAuthentication Auth

@if (AuthState.SignInModalOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="signin-title">
            <div class="modal-header">
                <h3 id="signin-title">@Heading</h3>
                <button class="btn btn-ghost" @onclick="Close" aria-label="Close"><Icon Name="close" /></button>
            </div>

            <div class="modal-body">
                <ErrorBanner Message="@_error" />

                @if (_mode == Mode.Reset)
                {
                    <p>Enter your email and we'll send you a link to reset your password.</p>
                    <ErrorBanner Message="@_notice" Kind="success" />

                    <div class="field" style="margin-top:1rem">
                        <label for="reset-email">Email</label>
                        <input id="reset-email" class="input" type="email" @bind="_email" @bind:event="oninput" autocomplete="email" />
                    </div>

                    <button class="btn btn-primary btn-block" @onclick="SendResetAsync" disabled="@_busy">
                        @if (_busy) { <span class="spinner"></span> } else { <text>Send reset link</text> }
                    </button>

                    <p style="margin-top:1rem;text-align:center">
                        <button class="link-button" @onclick="() => SetMode(Mode.SignIn)">Back to sign in</button>
                    </p>
                }
                else
                {
                    <div class="provider-list">
                        <button class="provider-btn" @onclick="@(() => SignInWithProviderAsync("google"))" disabled="@_busy">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z" />
                                <path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3a7.2 7.2 0 0 1-10.7-3.8H1.3v3.1A12 12 0 0 0 12 24z" />
                                <path fill="#FBBC05" d="M5.3 14.3a7.1 7.1 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8l4-3.1z" />
                                <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.5-3.5A12 12 0 0 0 1.3 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8z" />
                            </svg>
                            Continue with Google
                        </button>

                        <button class="provider-btn" @onclick="@(() => SignInWithProviderAsync("github"))" disabled="@_busy">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.9 10.9c.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z" />
                            </svg>
                            Continue with GitHub
                        </button>

                        <button class="provider-btn" @onclick="@(() => SignInWithProviderAsync("microsoft"))" disabled="@_busy">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="#F25022" d="M2 2h9.5v9.5H2z" />
                                <path fill="#7FBA00" d="M12.5 2H22v9.5h-9.5z" />
                                <path fill="#00A4EF" d="M2 12.5h9.5V22H2z" />
                                <path fill="#FFB900" d="M12.5 12.5H22V22h-9.5z" />
                            </svg>
                            Continue with Microsoft
                        </button>
                    </div>

                    <div class="divider">or</div>

                    @if (_mode == Mode.Register)
                    {
                        <div class="field">
                            <label for="reg-name">Name</label>
                            <input id="reg-name" class="input" @bind="_displayName" @bind:event="oninput" autocomplete="name" />
                        </div>
                    }

                    <div class="field">
                        <label for="auth-email">Email</label>
                        <input id="auth-email" class="input" type="email" @bind="_email" @bind:event="oninput" autocomplete="email" />
                    </div>

                    <div class="field">
                        <label for="auth-password">Password</label>
                        <input id="auth-password" class="input" type="password" @bind="_password" @bind:event="oninput"
                               autocomplete="@(_mode == Mode.Register ? "new-password" : "current-password")" />
                    </div>

                    <button class="btn btn-primary btn-block" @onclick="SubmitEmailAsync" disabled="@(_busy || !CanSubmitEmail)">
                        @if (_busy) { <span class="spinner"></span> }
                        else { <text>@(_mode == Mode.Register ? "Create account" : "Sign in")</text> }
                    </button>

                    <p style="margin-top:1rem;text-align:center;font:var(--text-caption);color:var(--on-surface-variant)">
                        @if (_mode == Mode.Register)
                        {
                            <text>Already have an account? </text>
                            <button class="link-button" @onclick="() => SetMode(Mode.SignIn)">Sign in</button>
                        }
                        else
                        {
                            <text>New here? </text>
                            <button class="link-button" @onclick="() => SetMode(Mode.Register)">Create an account</button>
                            <text> · </text>
                            <button class="link-button" @onclick="() => SetMode(Mode.Reset)">Forgot password?</button>
                        }
                    </p>
                }
            </div>
        </div>
    </div>
}

@code {
    private enum Mode { SignIn, Register, Reset }

    private Mode    _mode = Mode.SignIn;
    private string  _email = "";
    private string  _password = "";
    private string  _displayName = "";
    private string? _error;
    private string? _notice;
    private bool    _busy;

    private string Heading => _mode switch
    {
        Mode.Register => "Create your account",
        Mode.Reset    => "Reset your password",
        _             => AuthState.PendingBookUid is null ? "Sign in to Learn It All" : "Sign in to buy this book"
    };

    private bool CanSubmitEmail
        => !string.IsNullOrWhiteSpace(_email)
        && _password.Length >= 6
        && (_mode != Mode.Register || !string.IsNullOrWhiteSpace(_displayName));

    protected override void OnInitialized() => AuthState.OnChange += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void SetMode(Mode mode)
    {
        _mode   = mode;
        _error  = null;
        _notice = null;
    }

    private void Close()
    {
        SetMode(Mode.SignIn);
        _password = "";
        AuthState.CloseSignInModal();
    }

    // A non-null return from the auth layer is a user-facing message, not an exception.
    private async Task RunAsync(Func<Task<string?>> action, string? successNotice = null)
    {
        _busy   = true;
        _error  = null;
        _notice = null;
        StateHasChanged();

        try
        {
            _error = await action();
            if (_error is null) _notice = successNotice;
        }
        catch (Exception)
        {
            _error = "Something went wrong signing you in. Please try again.";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private Task SignInWithProviderAsync(string providerId)
        => RunAsync(() => Auth.SignInWithProviderAsync(providerId));

    private Task SubmitEmailAsync()
        => RunAsync(() => _mode == Mode.Register
                              ? Auth.RegisterWithEmailAsync(_email.Trim(), _password, _displayName.Trim())
                              : Auth.SignInWithEmailAsync(_email.Trim(), _password));

    private Task SendResetAsync()
        => RunAsync(() => Auth.SendPasswordResetAsync(_email.Trim()),
                    "If that email has an account, a reset link is on its way.");

    public void Dispose() => AuthState.OnChange -= OnStateChanged;
}
