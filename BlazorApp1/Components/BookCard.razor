@* Storefront card: cover, title, price, and a commerce-orange Buy Now. *@

<article class="book-card">
    <div class="book-cover">
        @if (!string.IsNullOrWhiteSpace(Book.ImageCoverUrl))
        {
            <img src="@Book.ImageCoverUrl" alt="Cover of @(Book.Title ?? "this book")" loading="lazy" />
        }
        else
        {
            <div class="cover-placeholder"><Icon Name="menu_book" Size="48" /></div>
        }
    </div>

    <div class="book-body">
        <h3 class="book-title">@(Book.Title ?? "Untitled")</h3>

        @if (!string.IsNullOrWhiteSpace(Book.Description))
        {
            <p class="book-desc">@Book.Description</p>
        }

        <div class="book-footer">
            @if (IsOwned)
            {
                <span class="owned-tag"><Icon Name="check_circle" Size="16" /> Owned</span>
                <button class="btn btn-primary btn-sm" @onclick="() => OnRead.InvokeAsync(Book)">Read Now</button>
            }
            else
            {
                <span class="book-price">@Book.Price.ToString("C0", PhCulture)</span>
                <button class="btn btn-commerce btn-sm" @onclick="() => OnBuy.InvokeAsync(Book)">Buy Now</button>
            }
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Book Book { get; set; } = new();
    [Parameter] public bool IsOwned { get; set; }
    [Parameter] public EventCallback<Book> OnBuy { get; set; }
    [Parameter] public EventCallback<Book> OnRead { get; set; }

    private static readonly System.Globalization.CultureInfo PhCulture = new("en-PH");
}
