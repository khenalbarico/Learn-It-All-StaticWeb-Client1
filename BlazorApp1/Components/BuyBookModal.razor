@implements IAsyncDisposable
@inject IPaymentService PaymentService
@inject AuthSessionState AuthState

@* Single-book QRPh checkout: create the intent, show the QR, poll until it settles. *@
@if (Book is not null)
{
    <div class="modal-backdrop" @onclick="RequestClose">
        <div class="modal modal-wide" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="buy-title">
            <div class="modal-header">
                <h3 id="buy-title">@(_state == State.Paid ? "Payment received" : "Pay with QR Ph")</h3>
                <button class="btn btn-ghost" @onclick="RequestClose" aria-label="Close"><Icon Name="close" /></button>
            </div>

            <div class="modal-body">
                <ErrorBanner Message="@_error" />

                @switch (_state)
                {
                    case State.Creating:
                        <div class="qr-panel">
                            <span class="spinner" style="width:2rem;height:2rem"></span>
                            <p>Generating your QR code…</p>
                        </div>
                        break;

                    case State.AwaitingPayment:
                        <div class="qr-panel">
                            <p><strong>@Book.Title</strong></p>
                            @if (!string.IsNullOrWhiteSpace(_payment?.QrImageUrl))
                            {
                                <img src="@_payment.QrImageUrl" alt="QR Ph payment code" />
                            }
                            <span class="qr-amount">@(_payment?.Amount.ToString("C2", PhCulture))</span>
                            <p>Scan this with any QR Ph-enabled banking or e-wallet app.</p>
                            <span class="qr-timer @(_secondsLeft <= 30 ? "urgent" : "")">
                                Expires in @($"{_secondsLeft / 60:0}:{_secondsLeft % 60:00}")
                            </span>
                            <p class="qr-waiting" role="status">
                                <span class="spinner"></span>
                                <span>Waiting for your payment — this screen updates on its own.</span>
                            </p>
                            <p class="form-hint">Keep this open until it confirms. If you close it after paying, the book still arrives — check My Library.</p>
                        </div>
                        break;

                    case State.Paid:
                        <div class="qr-panel">
                            <Icon Name="check_circle" Size="56" Filled="true" CssClass="success-mark" />
                            <p><strong>@Book.Title</strong> has been added to your library.</p>
                            <button class="btn btn-primary" @onclick="RequestClose">Go to My Library</button>
                        </div>
                        break;

                    @* Checkout never started, so no money moved for *this* attempt — but an
                       earlier attempt may still be settling, hence the softer wording. *@
                    case State.Retryable:
                        <div class="qr-panel">
                            <Icon Name="error" Size="56" />
                            <p>We couldn't open the payment screen just now.</p>
                            <button class="btn btn-primary" @onclick="StartAsync">Try again</button>
                        </div>
                        break;

                    case State.Expired:
                        <div class="qr-panel">
                            <Icon Name="timer_off" Size="56" />
                            <p>This QR code expired before payment was received.</p>
                            <button class="btn btn-primary" @onclick="StartAsync">Generate a new code</button>
                        </div>
                        break;

                    case State.Failed:
                        <div class="qr-panel">
                            <Icon Name="error" Size="56" />
                            <p>The payment did not go through. Nothing has been charged.</p>
                            <button class="btn btn-primary" @onclick="StartAsync">Try again</button>
                        </div>
                        break;
                }
            </div>
        </div>
    </div>
}

@code {
    // Failed means PayMongo told us the payment itself did not go through — only then is it
    // safe to say nothing was charged. Retryable means we never got as far as asking.
    private enum State { Creating, AwaitingPayment, Paid, Expired, Failed, Retryable }

    [Parameter] public Book? Book { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnPurchased { get; set; }

    private static readonly System.Globalization.CultureInfo PhCulture = new("en-PH");

    private State                _state = State.Creating;
    private CreatePaymentResult? _payment;
    private string?              _error;
    private bool                 _checking;
    private int                  _secondsLeft;
    private int                  _ticks;
    private Timer?               _poller;
    private string?              _startedForBookUid;

    protected override async Task OnParametersSetAsync()
    {
        if (Book is null)
        {
            await StopPollingAsync();
            _startedForBookUid = null;
            return;
        }

        if (_startedForBookUid == Book.Uid) return;

        _startedForBookUid = Book.Uid;
        await StartAsync();
    }

    private async Task StartAsync()
    {
        if (Book is null) return;

        await StopPollingAsync();
        _state = State.Creating;
        _error = null;
        StateHasChanged();

        try
        {
            _payment     = await PaymentService.CreatePaymentIntent(Book.Uid);
            _secondsLeft = Math.Max((int)(_payment.ExpiresAt - DateTime.UtcNow).TotalSeconds, 0);
            _state       = State.AwaitingPayment;
            _ticks       = 0;

            // One tick a second drives the countdown; the API is asked far less often so
            // waiting at the QR screen stays cheap.
            _poller = new Timer(_ => InvokeAsync(TickAsync), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        }
        // The payment already landed — most likely it settled by webhook after this modal
        // was closed. Saying "nothing has been charged" here would be a lie to someone who
        // has in fact paid, so treat it as the success it is.
        catch (AlreadyOwnedException)
        {
            _state = State.Paid;
            await AuthState.OnPurchaseCompletedAsync();
            await OnPurchased.InvokeAsync();
        }
        catch (TooManyAttemptsException ex)
        {
            _error = ex.RetryAfterSeconds > 0
                ? $"{ex.Message} You can try again in {ex.RetryAfterSeconds}s."
                : ex.Message;
            _state = State.Retryable;
        }
        catch (Exception ex) when (ex is ApiUnavailableException or PaymentProviderUnavailableException)
        {
            _error = ex.Message;
            _state = State.Retryable;
        }
        catch (Exception)
        {
            _error = "Could not start the payment. Please try again.";
            _state = State.Retryable;
        }

        StateHasChanged();
    }

    // A stored read only sees what the webhook already wrote, so it's cheap and runs often.
    // The force-verify asks PayMongo directly and is the fallback for a webhook that never
    // arrives — the job the removed "I've paid" button used to do by hand.
    //
    // The QR is valid for 15 minutes, but nobody pays it at a constant rate: the first couple
    // of minutes are the active ones. Polling backs off after that so an abandoned tab doesn't
    // spend the rest of the window billing Functions and Table Storage.
    private const int ActivePhaseSeconds = 120;

    private int StoredCheckSeconds => _ticks <= ActivePhaseSeconds ? 5 : 15;
    private int ForceVerifySeconds => _ticks <= ActivePhaseSeconds ? 15 : 60;

    private async Task TickAsync()
    {
        if (_state != State.AwaitingPayment) return;

        _secondsLeft = Math.Max(_secondsLeft - 1, 0);
        _ticks++;

        if (_secondsLeft == 0)
        {
            await CheckStatusAsync(true);
            return;
        }

        if (_ticks % ForceVerifySeconds == 0)
            await CheckStatusAsync(true);
        else if (_ticks % StoredCheckSeconds == 0)
            await CheckStatusAsync(false);
        else
            StateHasChanged();
    }

    private async Task CheckStatusAsync(bool forceVerify)
    {
        if (_payment is null || _checking) return;

        _checking = true;

        try
        {
            var status = await PaymentService.GetPaymentStatus(_payment.PaymentIntentId, forceVerify);

            switch (status.Status)
            {
                case "Succeeded":
                    _state = State.Paid;
                    await StopPollingAsync();
                    await AuthState.OnPurchaseCompletedAsync();
                    await OnPurchased.InvokeAsync();
                    break;

                case "Expired":
                    _state = State.Expired;
                    await StopPollingAsync();
                    break;

                case "Failed":
                    _state = State.Failed;
                    await StopPollingAsync();
                    break;
            }
        }
        catch (Exception)
        {
            // A transient status check failure shouldn't tear down a live QR code.
        }
        finally
        {
            _checking = false;
            StateHasChanged();
        }
    }

    private async Task RequestClose()
    {
        // A QR being dismissed may have been scanned seconds ago. One last authoritative
        // check on the way out catches a payment that landed between polls, so closing the
        // window can't strand a purchase the buyer has already made.
        var wasAwaitingPayment = _state == State.AwaitingPayment;

        await StopPollingAsync();

        if (wasAwaitingPayment)
        {
            await CheckStatusAsync(true);

            if (_state == State.Paid)
            {
                StateHasChanged();
                return;
            }
        }

        _startedForBookUid = null;
        await OnClose.InvokeAsync();
    }

    private async Task StopPollingAsync()
    {
        if (_poller is null) return;

        var poller = _poller;
        _poller = null;
        await poller.DisposeAsync();
    }

    public async ValueTask DisposeAsync() => await StopPollingAsync();
}
