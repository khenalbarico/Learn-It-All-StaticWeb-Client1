@* Material Symbols Outlined, the icon set the Stitch design is drawn against. *@
<span class="material-symbols-outlined @(Filled ? "filled" : "") @CssClass"
      style="font-size:@(Size)px"
      aria-hidden="true">@Name</span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public bool Filled { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
}
