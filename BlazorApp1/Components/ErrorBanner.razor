@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="banner banner-@Kind" role="@(Kind == "error" ? "alert" : "status")">
        <Icon Name="@IconFor(Kind)" Size="18" />
        <span>@Message</span>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public string Kind { get; set; } = "error";

    private static string IconFor(string kind) => kind switch
    {
        "success" => "check_circle",
        "info"    => "info",
        _         => "error"
    };
}
