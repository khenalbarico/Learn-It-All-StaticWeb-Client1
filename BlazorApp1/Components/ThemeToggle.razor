@implements IDisposable
@inject ThemeService ThemeService

@* Names must be real Material Symbols ligatures — an unknown name renders as its own
   literal text instead of a glyph. *@
<button class="btn btn-ghost" @onclick="Toggle"
        title="@Label" aria-label="@Label">
    <Icon Name="@(IsDark ? "light_mode" : "dark_mode")" Size="22" />
</button>

@code {
    private bool IsDark => ThemeService.CurrentTheme == AppTheme.Dark;

    private string Label => IsDark ? "Switch to light mode" : "Switch to dark mode";

    protected override void OnInitialized() => ThemeService.OnChange += StateHasChanged;

    private Task Toggle() => ThemeService.ToggleAsync();

    public void Dispose() => ThemeService.OnChange -= StateHasChanged;
}
