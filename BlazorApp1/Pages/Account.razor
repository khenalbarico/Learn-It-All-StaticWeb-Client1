@page "/account"
@implements IDisposable
@inject AuthSessionState AuthState

<PageTitle>Account — Learn It-All</PageTitle>

<div class="container">
    <div class="page-header">
        <h1>Account</h1>
    </div>

    @if (AuthState.IsBusy)
    {
        <div class="card"><span class="spinner"></span></div>
    }
    else if (!AuthState.IsAuthenticated)
    {
        <EmptyState IconName="account_circle"
                    Title="You're not signed in"
                    Message="Sign in to view your account details and library.">
            <button class="btn btn-primary" style="margin-top:1rem" @onclick="() => AuthState.OpenSignInModal()">Sign in</button>
        </EmptyState>
    }
    else
    {
        <ErrorBanner Message="@AuthState.ProfileLoadError" />

        <div class="card">
            <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem">
                @if (!string.IsNullOrWhiteSpace(AuthState.PhotoUrl))
                {
                    <img class="avatar" style="width:4rem;height:4rem" src="@AuthState.PhotoUrl" alt="" referrerpolicy="no-referrer" />
                }
                else
                {
                    <span class="avatar avatar-fallback" style="width:4rem;height:4rem;font-size:1.5rem">@Initial</span>
                }
                <div>
                    <h3>@(AuthState.CurrentUser?.DisplayName ?? "Reader")</h3>
                    <p style="color:var(--on-surface-variant)">@AuthState.CurrentUser?.Email</p>
                </div>
            </div>

            <dl style="margin:0">
                <div class="detail-row"><dt>Phone</dt><dd>@Display(AuthState.CurrentUser?.PhoneNumber)</dd></div>
                <div class="detail-row"><dt>Plan</dt><dd>@AuthState.CurrentUser?.Subscription</dd></div>
                <div class="detail-row"><dt>Books owned</dt><dd>@(AuthState.CurrentUser?.Library.Count ?? 0)</dd></div>
            </dl>

            <button class="btn btn-outline" style="margin-top:1.5rem" @onclick="SignOutAsync" disabled="@_signingOut">
                @if (_signingOut) { <span class="spinner"></span> } else { <text>Sign out</text> }
            </button>
        </div>
    }
</div>

@code {
    private bool _signingOut;

    private string Initial
    {
        get
        {
            var source = AuthState.CurrentUser?.DisplayName;
            return string.IsNullOrWhiteSpace(source) ? "?" : source.Trim()[..1].ToUpperInvariant();
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    protected override void OnInitialized() => AuthState.OnChange += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        _signingOut = true;
        try   { await AuthState.SignOutAsync(); }
        finally { _signingOut = false; }
    }

    public void Dispose() => AuthState.OnChange -= OnStateChanged;
}
