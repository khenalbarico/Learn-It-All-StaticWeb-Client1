@page "/read/{BookUid}"
@implements IAsyncDisposable
@inject IAppService AppService
@inject AuthSessionState AuthState
@inject LibraryCacheService LibraryCache
@inject JsInteropService JsInterop
@inject NavigationManager Nav

<PageTitle>@(_book?.Title ?? "Reading") — Learn It All</PageTitle>

<div class="reader-page">
    <div class="reader-toolbar">
        <button class="btn btn-ghost" @onclick="BackToLibrary" title="Back to My Library" aria-label="Back to My Library">
            <Icon Name="arrow_back" />
        </button>

        <div class="reader-titles">
            <span class="reader-book-title">@(_book?.Title ?? "")</span>
        </div>

        @if (_entry is not null)
        {
            <button class="btn btn-ghost reader-favorite @(_isFavorite ? "is-favorite" : "")"
                    @onclick="ToggleFavoriteAsync"
                    title="@(_isFavorite ? "Remove from favourites" : "Add to favourites")"
                    aria-label="Toggle favourite">
                <Icon Name="bookmark" Filled="_isFavorite" />
            </button>
        }

        @if (_libraryBooks.Count > 1)
        {
            <select class="reader-select" value="@BookUid" @onchange="OnBookChanged" disabled="@_loading" aria-label="Switch book">
                @foreach (var b in _libraryBooks)
                {
                    <option value="@b.Uid">@(b.Title ?? "Untitled")</option>
                }
            </select>
        }

        <button class="btn btn-ghost" @onclick="() => ZoomAsync(-1)" disabled="@_loading" aria-label="Zoom out"><Icon Name="zoom_out" /></button>
        <button class="btn btn-ghost" @onclick="() => ZoomAsync(1)" disabled="@_loading" aria-label="Zoom in"><Icon Name="zoom_in" /></button>
    </div>

    @if (!AuthState.IsBusy && !AuthState.IsAuthenticated)
    {
        <div class="container" style="padding-block:var(--space-4)">
            <EmptyState IconName="lock" Title="Sign in to read" Message="This book is in your library once you're signed in.">
                <button class="btn btn-primary" style="margin-top:1rem" @onclick="() => AuthState.OpenSignInModal()">Sign in</button>
            </EmptyState>
        </div>
    }
    else if (_error is not null)
    {
        <div class="container" style="padding-block:var(--space-4)">
            <ErrorBanner Message="@_error" />
            <button class="btn btn-outline" @onclick="BackToLibrary">Back to My Library</button>
        </div>
    }
    else
    {
        <div class="reader-canvas" id="@ContainerId">
            @if (_loading)
            {
                <div style="display:grid;place-items:center;width:100%">
                    <span class="spinner" style="width:2.5rem;height:2.5rem;color:var(--primary)"></span>
                </div>
            }
        </div>

        @if (!_loading && _totalPages > 0)
        {
            <div class="reader-pager">
                <button class="btn btn-ghost" @onclick="() => GoToPageAsync(_page - 1)" disabled="@(_page <= 1)" aria-label="Previous page">
                    <Icon Name="chevron_left" Size="24" />
                </button>
                <span class="reader-page-label">Page @_page of @_totalPages</span>
                <button class="btn btn-ghost" @onclick="() => GoToPageAsync(_page + 1)" disabled="@(_page >= _totalPages)" aria-label="Next page">
                    <Icon Name="chevron_right" Size="24" />
                </button>
            </div>
        }
    }
</div>

@code {
    private const string ContainerId = "reader-canvas";

    [Parameter] public string BookUid { get; set; } = "";

    private Book?       _book;
    private UserLibrary? _entry;
    private List<Book>  _libraryBooks = [];
    private string?     _error;
    private bool        _loading = true;
    private bool        _isFavorite;
    private int         _page = 1;
    private int         _totalPages;
    private string?     _loadedBookUid;

    protected override async Task OnParametersSetAsync()
    {
        if (!AuthState.IsAuthenticated || _loadedBookUid == BookUid) return;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The auth state can land after the first render; pick the book up then.
        if (AuthState.IsAuthenticated && _loadedBookUid != BookUid && _error is null && !_rendering)
            await LoadAsync();
    }

    private bool _rendering;

    private async Task LoadAsync()
    {
        _rendering     = true;
        _loading       = true;
        _error         = null;
        _loadedBookUid = BookUid;
        StateHasChanged();

        try
        {
            _libraryBooks = await AppService.GetMyLibraryBooks();
            _book         = _libraryBooks.FirstOrDefault(b => b.Uid == BookUid);

            if (_book is null)
            {
                _error = "This book isn't in your library.";
                return;
            }

            _entry      = AuthState.CurrentUser?.Library.FirstOrDefault(l => l.Uid == BookUid);
            _isFavorite = _entry?.IsFavorite == true;

            // A presigned URL is reused while it's still valid, so re-opening a book
            // in the same session costs nothing.
            if (!LibraryCache.TryGetReadUrl(BookUid, out var url))
            {
                var readUrl = await AppService.GetBookReadUrl(BookUid);
                LibraryCache.SetReadUrl(BookUid, readUrl);
                url = readUrl.Url;
            }

            _loading = false;
            StateHasChanged();

            _totalPages = await JsInterop.LoadPdfFromUrlAsync(ContainerId, url);

            var resumeAt = _entry?.LastReadPage ?? 0;
            _page = resumeAt is > 0 && resumeAt <= _totalPages ? resumeAt : 1;

            if (_page > 1)
                await JsInterop.GoToPdfPageAsync(ContainerId, _page);
        }
        catch (ApiUnavailableException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Could not open this book. Please try again.";
        }
        finally
        {
            _loading   = false;
            _rendering = false;
            StateHasChanged();
        }
    }

    private async Task GoToPageAsync(int page)
    {
        _page = await JsInterop.GoToPdfPageAsync(ContainerId, page);
        await SaveProgressAsync();
    }

    private Task ZoomAsync(int delta) => JsInterop.ZoomPdfAsync(ContainerId, delta);

    // Progress is written on page turns only, which is where it actually changes.
    private async Task SaveProgressAsync()
    {
        AuthState.UpdateLocalReadingProgress(BookUid, _page, _totalPages);

        try   { await AppService.SaveReadingProgress(BookUid, _page, _totalPages); }
        catch { /* losing a progress ping must not interrupt reading */ }
    }

    private async Task ToggleFavoriteAsync()
    {
        _isFavorite = !_isFavorite;
        if (_entry is not null) _entry.IsFavorite = _isFavorite;

        try   { await AppService.SetFavorite(BookUid, _isFavorite); }
        catch { _isFavorite = !_isFavorite; }
    }

    private async Task OnBookChanged(ChangeEventArgs e)
    {
        var uid = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(uid) || uid == BookUid) return;

        await JsInterop.DisposePdfAsync(ContainerId);
        Nav.NavigateTo($"read/{uid}");
    }

    private void BackToLibrary() => Nav.NavigateTo("my-library");

    public async ValueTask DisposeAsync()
    {
        try   { await JsInterop.DisposePdfAsync(ContainerId); }
        catch (JSDisconnectedException) { }
    }
}
