@page "/my-library"
@implements IDisposable
@inject IAppService AppService
@inject AuthSessionState AuthState
@inject NavigationManager Nav

<PageTitle>My Library — Learn It All</PageTitle>

<div class="container">
    <div class="toolbar page-header">
        <div>
            <h1>My Library</h1>
            <p class="subtitle">Continue your learning journey.</p>
        </div>

        @if (AuthState.IsAuthenticated && _books.Count > 0)
        {
            <div class="segmented" role="tablist">
                @foreach (var filter in Filters)
                {
                    <button class="@(_filter == filter ? "active" : "")" role="tab"
                            aria-selected="@(_filter == filter)"
                            @onclick="() => _filter = filter">@filter</button>
                }
            </div>
        }
    </div>

    @if (AuthState.IsBusy)
    {
        <div class="book-grid">
            @for (var i = 0; i < 4; i++) { <BookCardSkeleton /> }
        </div>
    }
    else if (!AuthState.IsAuthenticated)
    {
        @* Signed out means there is no user data to fill this page with. *@
        <EmptyState IconName="lock"
                    Title="Sign in to see your library"
                    Message="Your purchased books live here once you're signed in.">
            <button class="btn btn-primary" style="margin-top:1rem" @onclick="() => AuthState.OpenSignInModal()">Sign in</button>
        </EmptyState>
    }
    else
    {
        <ErrorBanner Message="@_error" />

        @if (_loading)
        {
            <div class="book-grid">
                @for (var i = 0; i < 4; i++) { <BookCardSkeleton /> }
            </div>
        }
        else if (Visible.Count == 0)
        {
            <EmptyState IconName="auto_stories"
                        Title="@(_books.Count == 0 ? "No books yet" : "Nothing in this view")"
                        Message="@(_books.Count == 0 ? "Books you buy will appear here." : "Try a different filter.")">
                @if (_books.Count == 0)
                {
                    <a class="btn btn-primary" style="margin-top:1rem" href="books">Browse the collection</a>
                }
            </EmptyState>
        }
        else
        {
            <div class="book-grid">
                @foreach (var book in Visible)
                {
                    <LibraryBookCard Book="book" Entry="EntryFor(book)" OnRead="Read" @key="book.Uid" />
                }
            </div>
        }
    }
</div>

@code {
    private static readonly string[] Filters = ["All Books", "In Progress", "Completed"];

    private List<Book> _books = [];
    private string     _filter = Filters[0];
    private string?    _error;
    private bool       _loading;

    private List<Book> Visible => _filter switch
    {
        "In Progress" => _books.Where(b => EntryFor(b) is { ProgressPercent: > 0 and < 100 }).ToList(),
        "Completed"   => _books.Where(b => EntryFor(b)?.ProgressPercent >= 100).ToList(),
        _             => _books
    };

    private UserLibrary? EntryFor(Book book)
        => AuthState.CurrentUser?.Library.FirstOrDefault(l => l.Uid == book.Uid);

    protected override async Task OnInitializedAsync()
    {
        AuthState.OnChange += HandleStateChanged;

        if (AuthState.IsAuthenticated)
            await LoadAsync();
    }

    private async void HandleStateChanged()
    {
        await InvokeAsync(async () =>
        {
            if (AuthState.IsAuthenticated && _books.Count == 0 && !_loading)
                await LoadAsync();

            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;

        try
        {
            _books = await AppService.GetMyLibraryBooks();
        }
        catch (ApiUnavailableException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Could not load your library. Please try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void Read(Book book) => Nav.NavigateTo($"read/{book.Uid}");

    public void Dispose() => AuthState.OnChange -= HandleStateChanged;
}
