@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — Learn It-All</PageTitle>

<div class="page-container centered-notice">
    <span class="notice-code">404</span>
    <h1>We couldn't find that page</h1>
    <p>
        The link may be broken, or the page may have moved. Everything else is still
        where you left it.
    </p>
    <div class="notice-actions">
        <a class="btn btn-primary" href="/">Back to the shop</a>
        <a class="btn btn-outline" href="books">Browse all books</a>
        <a class="btn btn-ghost" href="my-library">My Library</a>
    </div>
</div>
