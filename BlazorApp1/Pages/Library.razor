@page "/books"
@inherits StorePageBase

<PageTitle>Browse Books — Learn It All</PageTitle>

<div class="container">
    <div class="page-header">
        <h1>The Collection</h1>
        <p class="subtitle">Every title in the Learn It All catalogue.</p>
    </div>

    <ErrorBanner Message="@LoadError" />

    @if (Loading)
    {
        <div class="book-grid">
            @for (var i = 0; i < 8; i++) { <BookCardSkeleton /> }
        </div>
    }
    else if (Visible.Count == 0)
    {
        <EmptyState IconName="@(string.IsNullOrWhiteSpace(SearchState.Query) ? "library_books" : "search_off")"
                    Title="@(string.IsNullOrWhiteSpace(SearchState.Query) ? "No books available yet" : "No matches")"
                    Message="@(string.IsNullOrWhiteSpace(SearchState.Query) ? "New titles are on the way — check back soon." : $"Nothing matched \"{SearchState.Query}\".")" />
    }
    else
    {
        <div class="book-grid">
            @foreach (var book in Visible)
            {
                <BookCard Book="book" IsOwned="IsOwned(book)" OnBuy="HandleBuy" OnRead="HandleRead" @key="book.Uid" />
            }
        </div>
    }
</div>

<BuyBookModal Book="BuyingBook" OnClose="CloseBuyModal" OnPurchased="HandlePurchased" />

@code {
    private List<Book> Visible => Books.Where(SearchState.Matches).ToList();

    protected override void OnAfterRender(bool firstRender) => ResumePendingPurchase();

    private void HandlePurchased() => StateHasChanged();
}
