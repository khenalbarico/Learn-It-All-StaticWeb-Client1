@page "/"
@inherits StorePageBase

<PageTitle>Learn It All — Academic Bookstore</PageTitle>

<div class="container">
    <section class="hero">
        <div>
            <h1>Empowering Minds, One Book at a Time.</h1>
            <p>
                Discover a curated collection of academic literature designed to foster intellectual
                growth and rigorous study. From fundamental textbooks to advanced reviewers, we provide
                the resources you need to master your field.
            </p>
            <a class="btn btn-primary" href="books">Explore Collection</a>
        </div>
        <div class="hero-art">
            <img src="imgs/learnitall-logo.png" alt="Learn It All" />
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">Featured Publications</h2>

        <ErrorBanner Message="@LoadError" />

        @if (Loading)
        {
            <div class="book-grid">
                @for (var i = 0; i < 4; i++) { <BookCardSkeleton /> }
            </div>
        }
        else if (Featured.Count == 0)
        {
            <EmptyState IconName="library_books"
                        Title="No books available yet"
                        Message="New titles are on the way — check back soon." />
        }
        else
        {
            <div class="book-grid">
                @foreach (var book in Featured)
                {
                    <BookCard Book="book" IsOwned="IsOwned(book)" OnBuy="HandleBuy" OnRead="HandleRead" @key="book.Uid" />
                }
            </div>

            @if (Books.Count > Featured.Count)
            {
                <p style="margin-top:1.5rem;text-align:center">
                    <a class="btn btn-outline" href="books">Browse all @Books.Count books</a>
                </p>
            }
        }
    </section>
</div>

<BuyBookModal Book="BuyingBook" OnClose="CloseBuyModal" OnPurchased="HandlePurchased" />

@code {
    private List<Book> Featured => Books.Take(8).ToList();

    protected override void OnAfterRender(bool firstRender) => ResumePendingPurchase();

    private void HandlePurchased() => StateHasChanged();
}
