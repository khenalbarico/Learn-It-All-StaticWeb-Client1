@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IAdSenseCfg AdCfg

<NavMenu />

@if (!IsReaderRoute)
{
    <AdUnit SlotId="@AdCfg.TopBannerSlotId" CssClass="ad-top-banner" />
}

<main>
    @Body
</main>

@if (!IsReaderRoute)
{
    <Footer />
}

<SignInModal />
<ProfileSetupModal />

@code {
    // The reader fills the viewport; a footer under it would push the canvas around.
    private bool IsReaderRoute
        => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("read/", StringComparison.OrdinalIgnoreCase);
}
