@implements IDisposable
@inject AuthSessionState AuthState
@inject NavigationManager Nav

<header class="site-header">
    <div class="container">
        <a class="brand" href="/">Learn It-All</a>

        <div class="header-search">
            <Icon Name="search" />
            <input class="input" type="search" placeholder="Search by title or description"
                   value="@SearchState.Query" @oninput="OnSearchInput" aria-label="Search books" />
        </div>

        <nav class="header-nav @(_menuOpen ? "open" : "")">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Shop</NavLink>
            <NavLink class="nav-link" href="my-library">Library</NavLink>
            <NavLink class="nav-link" href="account">Account</NavLink>
        </nav>

        <div class="header-actions">
            <ThemeToggle />

            @if (AuthState.IsBusy)
            {
                <span class="spinner" aria-label="Loading"></span>
            }
            else if (AuthState.IsAuthenticated)
            {
                <a href="account" aria-label="Your account">
                    @if (!string.IsNullOrWhiteSpace(AuthState.PhotoUrl))
                    {
                        <img class="avatar" src="@AuthState.PhotoUrl" alt="" referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <span class="avatar avatar-fallback">@Initial</span>
                    }
                </a>
            }
            else
            {
                <button class="btn btn-primary btn-sm" @onclick="() => AuthState.OpenSignInModal()">Sign in</button>
            }

            <button class="btn btn-ghost nav-toggle" @onclick="() => _menuOpen = !_menuOpen" aria-label="Toggle navigation">
                <Icon Name="@(_menuOpen ? "close" : "menu")" Size="24" />
            </button>
        </div>
    </div>
</header>

@code {
    private bool _menuOpen;

    private string Initial
    {
        get
        {
            var source = AuthState.CurrentUser?.DisplayName;
            return string.IsNullOrWhiteSpace(source) ? "?" : source.Trim()[..1].ToUpperInvariant();
        }
    }

    protected override void OnInitialized()
    {
        AuthState.OnChange += OnStateChanged;
        SearchState.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // Searching from any page lands on the catalogue, which is what actually filters.
    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchState.SetQuery(e.Value?.ToString() ?? "");
        _menuOpen = false;

        if (!Nav.ToBaseRelativePath(Nav.Uri).StartsWith("books", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(SearchState.Query))
        {
            Nav.NavigateTo("books");
        }
    }

    public void Dispose()
    {
        AuthState.OnChange -= OnStateChanged;
        SearchState.OnChange -= OnStateChanged;
    }
}
